// SPMA — Schema Prisma
// Fonte de verdade do modelo físico. Deriva de SPMA_Especificacao_Cliente_v2.md
// e das decisões em .specs/STATE.md (AD-001 a AD-033).
//
// Convenções:
// - Nomes de tabela seguem o documento do cliente (TB_*), via @@map.
// - Enums para TP_Usuario e Status (' ' em andamento / 'E' encerrado é modelado como enum EM_ANDAMENTO/ENCERRADO).
// - Cada pergunta dos questionários é uma coluna `P*` da tabela do próprio formulário:
//   ver nota "Estratégia de armazenamento das respostas" no fim do arquivo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum TipoUsuario {
  AM // Administrador Master
  GT // Gestor Turismo
  VT // Visualizador Turismo
  GO // Gestor Ofertante
  VO // Visualizador Ofertante
  AL // Aluno
}

enum StatusFormulario {
  EM_ANDAMENTO // corresponde a ' ' no documento original
  ENCERRADO    // corresponde a 'E'
}

// ─────────────────────────────────────────────────────────────
// USUÁRIO  (AD-007, AD-008, AD-009, AD-010, AD-011, AD-012)
// ─────────────────────────────────────────────────────────────

model Usuario {
  // 11 dígitos (CPF: AM/GT/VT/AL) ou 14 dígitos (CNPJ: GO), conforme `tipo`
  // (AD-043/UGO-07). Renomeado de `cpf` para `documento` porque deixou de
  // identificar só pessoa física - o GO é o próprio Ofertante, identificado
  // pelo CNPJ da organização.
  documento    String      @id @map("Documento_Usuario") @db.VarChar(14)
  // Para GO: nome da organização (antes `Ofertante.nome`). Para os demais
  // tipos: nome da pessoa, sem mudança.
  nome         String?     @map("NM_Usuario") @db.VarChar(255)
  email        String?     @map("Email_Usuario") @db.VarChar(255)
  tipo         TipoUsuario @map("TP_Usuario")

  // Dados organizacionais - só preenchidos para tipo=GO (fusão do antigo
  // `model Ofertante` no próprio GO, Decisão B1/AD-043).
  responsavel  String?     @map("Resp_Organizacao") @db.VarChar(255)
  telefone     String?     @map("Tel_Organizacao") @db.VarChar(50)
  uf           String?     @map("UF_Organizacao") @db.VarChar(2)
  municipio    String?     @map("Municipio_Organizacao") @db.VarChar(255)

  // VO vincula-se diretamente ao GO (documento/CNPJ); GO/AM/GT/VT/AL ficam
  // null - um GO não pertence a um Ofertante, ele É um (AD-043).
  cdOfertante  String?     @map("CD_Ofertante") @db.VarChar(14)
  ofertante    Usuario?    @relation("UsuarioOfertante", fields: [cdOfertante], references: [documento])
  vinculados   Usuario[]   @relation("UsuarioOfertante")

  // Autenticação (AD-005, AD-010, AD-030)
  senhaHash    String?     @map("Senha_Hash") @db.VarChar(255) // null até cadastrar no 1º acesso
  primeiraVez  Boolean     @default(true) @map("Primeira_Vez")

  // Gate de dados pessoais do Aluno (PESSOAL-02, PESSOAL-06). Mesmo padrão de
  // `primeiraVez`: flag persistida, não recomputada a cada navegação. O
  // `@default(false)` vale tanto para o Aluno novo quanto, ao adicionar a
  // coluna, para todo Aluno que já existia — é o que faz o gate valer também
  // para conta anterior a esta feature, sem `UPDATE` manual.
  dadosPessoaisCompletos Boolean @default(false) @map("Dados_Pessoais_Completos")

  // Gate de dados organizacionais do GO (OGO-01, AD-044): o próprio GO
  // declara os 6 campos no 1º acesso. Mesmo padrão de `dadosPessoaisCompletos`.
  // Ligada só por `PATCH /api/usuarios/me/organizacao` - nunca pela edição
  // por documento, porque significa "o GO declarou", não "os campos estão
  // cheios". Ignorada para qualquer tipo que não seja GO.
  dadosOrganizacionaisCompletos Boolean @default(false) @map("Dados_Organizacionais_Completos")

  // Rate limiting de login (AD-028) — contadores por conta
  tentativasFalhas    Int       @default(0) @map("Tentativas_Falhas")
  bloqueadoAte        DateTime? @map("Bloqueado_Ate")

  // Auditoria
  dataCriacao  DateTime    @default(now()) @map("Data_Criacao")
  criadoPor    String?     @map("Criado_Por") @db.VarChar(14)
  criador      Usuario?    @relation("Cascata", fields: [criadoPor], references: [documento])
  criados      Usuario[]   @relation("Cascata")

  // Relações de domínio
  avaliacoes       AvaliacaoAluno[] @relation("AlunoAvaliacoes")
  dadosPessoais    DadoPessoalAluno?
  cursosCriados    PreCurso[]       @relation("GoCursos")
  cursosOfertados  PreCurso[]       @relation("PreCursoOfertante")
  posCursosCriados PosCurso[]       @relation("GoPosCursos")
  verbas           Verba[]
  sessoes          Sessao[]

  @@index([cdOfertante])
  @@index([tipo])
  @@map("TB_Usuario")
}

// ─────────────────────────────────────────────────────────────
// SESSÃO  (AD-031: httpOnly/secure/sameSite, rotação, expiração)
// ─────────────────────────────────────────────────────────────

model Sessao {
  id            String    @id @default(uuid()) @map("ID_Sessao")
  // Nome de campo mantido (AD-043): largura ampliada para caber o CNPJ de um
  // GO logado, além do CPF dos demais tipos.
  cpfUsuario    String    @map("CPF_Usuario") @db.VarChar(14)
  usuario       Usuario   @relation(fields: [cpfUsuario], references: [documento], onDelete: Cascade)

  criadaEm      DateTime  @default(now()) @map("Criada_Em")
  ultimaAtividade DateTime @default(now()) @map("Ultima_Atividade")
  expiraEm      DateTime  @map("Expira_Em")

  @@index([cpfUsuario])
  @@map("TB_Sessao")
}

// ─────────────────────────────────────────────────────────────
// TENTATIVA DE LOGIN POR IP  (REQ-SEC-03: rate limit por origem,
// independente do CPF - complementa TB_Usuario.Tentativas_Falhas)
// ─────────────────────────────────────────────────────────────

model TentativaLoginIp {
  ip           String    @id @map("IP") @db.VarChar(45)
  tentativas   Int       @default(0) @map("Tentativas")
  bloqueadoAte DateTime? @map("Bloqueado_Ate")
  atualizadoEm DateTime  @updatedAt @map("Atualizado_Em")

  @@map("TB_Tentativa_Login_Ip")
}

// ─────────────────────────────────────────────────────────────
// VERBA  (AD-015: pertence ao GO/Ofertante, 1:N com Curso; AD-016: teto <=)
// `model Ofertante` removido (AD-043) - o GO passou a SER o Ofertante.
// ─────────────────────────────────────────────────────────────

model Verba {
  cdVerba        Int        @id @default(autoincrement()) @map("CD_Verba")
  // Aponta para o CNPJ (Usuario.documento) de um GO, não mais para um
  // `Ofertante` autônomo (AD-043). Nome de campo mantido.
  cdOfertante    String     @map("CD_Ofertante") @db.VarChar(14)
  ofertante      Usuario    @relation(fields: [cdOfertante], references: [documento])

  // Nome livre da verba, exibido na lista e no seletor de curso (IDV-01..14).
  // Pode repetir: o identificador continua sendo `cdVerba`.
  dsVerba        String     @map("DS_Verba") @db.VarChar(60)
  dtVerba        DateTime?  @map("DT_Verba") @db.Date
  vlVerba        Decimal    @map("VL_Verba") @db.Decimal(10, 2) // valor TOTAL da verba

  dataCriacao    DateTime   @default(now()) @map("Data_Criacao")

  // 1 verba : N cursos (a FK fica no curso). AD-015.
  cursos         PreCurso[]

  @@index([cdOfertante])
  @@map("TB_Verba")
}

// ─────────────────────────────────────────────────────────────
// PRÉ-CURSO  (AD-017, AD-018, AD-019)
// CD_Curso é PK autoincremento — NÃO é FK (bug corrigido).
// ─────────────────────────────────────────────────────────────

model PreCurso {
  cdCurso        Int              @id @default(autoincrement()) @map("CD_Curso")
  // Aponta para o CNPJ (Usuario.documento) de um GO, não mais para um
  // `Ofertante` autônomo (AD-043). Nome de campo mantido.
  cdOfertante    String           @map("CD_Ofertante") @db.VarChar(14)
  ofertante      Usuario          @relation("PreCursoOfertante", fields: [cdOfertante], references: [documento])

  // Verba que custeia este curso + valor alocado (AD-015, AD-016)
  cdVerba        Int              @map("CD_Verba")
  verba          Verba            @relation(fields: [cdVerba], references: [cdVerba])
  vlCursoAlocado Decimal          @map("VL_Curso_Alocado") @db.Decimal(10, 2)

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  dataCriacao       DateTime      @default(now()) @map("Data_Criacao")
  criadoPor         String        @map("Criado_Por") @db.VarChar(14)
  criador           Usuario       @relation("GoCursos", fields: [criadoPor], references: [documento])
  dataEncerramento  DateTime?     @map("Data_Encerramento")

  posCurso       PosCurso?
