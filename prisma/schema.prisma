// ─────────────────────────────────────────────────────────────
// AVALIAÇÃO DO ALUNO  (AD-018, AD-020, AD-022, AD-023)
// Chave composta (CPF + CD_Curso). Aluno pode ter vários cursos ao
// longo do tempo, mas só um em andamento por vez — regra aplicada na
// camada de aplicação (AD-022), não por constraint física.
// ─────────────────────────────────────────────────────────────

model AvaliacaoAluno {
  // Nome de campo mantido (AD-043): sempre referência a um Aluno, que nunca
  // muda de documento (continua CPF de 11 dígitos) - só a largura da coluna
  // acompanha `Usuario.documento`, que agora é VarChar(14).
  cpf            String           @map("CPF") @db.VarChar(14)
  cdCurso        Int              @map("CD_Curso")

  aluno          Usuario          @relation("AlunoAvaliacoes", fields: [cpf], references: [documento])
  curso          PreCurso         @relation(fields: [cdCurso], references: [cdCurso])

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  // Gate da Parte 2 (AD-023): dados pessoais/motivação completos.
  parte1Completa Boolean          @default(false) @map("Parte1_Completa")

  dataCriacao       DateTime      @default(now()) @map("Data_Criacao")
  dataEncerramento  DateTime?     @map("Data_Encerramento")

  // Respostas, uma coluna por pergunta (AD-051, `src/lib/respostas/colunas.ts`).
