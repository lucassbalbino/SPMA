// ─────────────────────────────────────────────────────────────
// PÓS-CURSO  (AD-017, AD-018: agora COM encerramento pelo GO)
// ─────────────────────────────────────────────────────────────

model PosCurso {
  cdCurso        Int              @id @map("CD_Curso")
  preCurso       PreCurso         @relation(fields: [cdCurso], references: [cdCurso], onDelete: Cascade)

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  dataCriacao          DateTime   @default(now()) @map("Data_Criacao")
  criadoPor            String     @map("Criado_Por") @db.VarChar(14)
  criador              Usuario    @relation("GoPosCursos", fields: [criadoPor], references: [documento])
  dataUltimaAtualizacao DateTime  @updatedAt @map("Data_Ultima_Atualizacao")
  dataEncerramento     DateTime?  @map("Data_Encerramento")

  // Respostas, uma coluna por pergunta (AD-051, `src/lib/respostas/colunas.ts`).
  p1       String?   @map("P1") @db.Char(1)
  p2       String?   @map("P2") @db.Char(1)
  p3       String?   @map("P3") @db.Char(1)
  p4       String?   @map("P4") @db.Char(1)
  p5       String?   @map("P5") @db.Char(1)
  p6a      Boolean?  @map("P6a")
  p6b      Boolean?  @map("P6b")
  p6c      Boolean?  @map("P6c")
  p6d      Boolean?  @map("P6d")
  p6e      Boolean?  @map("P6e")
  p6f      Boolean?  @map("P6f")
  p7       DateTime? @map("P7") @db.Date
  p8       DateTime? @map("P8") @db.Date
  p9       Int?      @map("P9")
  p10      String?   @map("P10") @db.Text
  p11      String?   @map("P11") @db.Char(1)
  p12      String?   @map("P12") @db.Text
  p13      Int?      @map("P13")
  p14      Int?      @map("P14")
  p15      Int?      @map("P15")
  p16a     Boolean?  @map("P16a")
  p16b     Boolean?  @map("P16b")
  p16c     Boolean?  @map("P16c")
  p16d     Boolean?  @map("P16d")
  p16e     Boolean?  @map("P16e")
  p16f     Boolean?  @map("P16f")
