// SPMA — Schema Prisma
// Fonte de verdade do modelo físico. Deriva de SPMA_Especificacao_Cliente_v2.md
// e das decisões em .specs/STATE.md (AD-001 a AD-033).
//
// Convenções:
// - Nomes de tabela seguem o documento do cliente (TB_*), via @@map.
// - Enums para TP_Usuario e Status (' ' em andamento / 'E' encerrado é modelado como enum EM_ANDAMENTO/ENCERRADO).
// - Campos de questionário (P1..P32, PG1..PG25, PA1..PA36) NÃO são colunas individuais aqui:
//   ver nota "Estratégia de armazenamento das respostas" no fim do arquivo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum TipoUsuario {
  AM // Administrador Master
  GT // Gestor Turismo
  VT // Visualizador Turismo
  GO // Gestor Ofertante
  VO // Visualizador Ofertante
  AL // Aluno
}

enum StatusFormulario {
  EM_ANDAMENTO // corresponde a ' ' no documento original
  ENCERRADO    // corresponde a 'E'
}

// ─────────────────────────────────────────────────────────────
// USUÁRIO  (AD-007, AD-008, AD-009, AD-010, AD-011, AD-012)
// ─────────────────────────────────────────────────────────────

model Usuario {
  // 11 dígitos (CPF: AM/GT/VT/AL) ou 14 dígitos (CNPJ: GO), conforme `tipo`
  // (AD-043/UGO-07). Renomeado de `cpf` para `documento` porque deixou de
  // identificar só pessoa física - o GO é o próprio Ofertante, identificado
  // pelo CNPJ da organização.
  documento    String      @id @map("Documento_Usuario") @db.VarChar(14)
  // Para GO: nome da organização (antes `Ofertante.nome`). Para os demais
  // tipos: nome da pessoa, sem mudança.
  nome         String?     @map("NM_Usuario") @db.VarChar(255)
  email        String?     @map("Email_Usuario") @db.VarChar(255)
  tipo         TipoUsuario @map("TP_Usuario")

  // Dados organizacionais - só preenchidos para tipo=GO (fusão do antigo
  // `model Ofertante` no próprio GO, Decisão B1/AD-043).
  responsavel  String?     @map("Resp_Organizacao") @db.VarChar(255)
  telefone     String?     @map("Tel_Organizacao") @db.VarChar(50)
  uf           String?     @map("UF_Organizacao") @db.VarChar(2)
  municipio    String?     @map("Municipio_Organizacao") @db.VarChar(255)

  // VO vincula-se diretamente ao GO (documento/CNPJ); GO/AM/GT/VT/AL ficam
  // null - um GO não pertence a um Ofertante, ele É um (AD-043).
  cdOfertante  String?     @map("CD_Ofertante") @db.VarChar(14)
  ofertante    Usuario?    @relation("UsuarioOfertante", fields: [cdOfertante], references: [documento])
  vinculados   Usuario[]   @relation("UsuarioOfertante")

  // Autenticação (AD-005, AD-010, AD-030)
  senhaHash    String?     @map("Senha_Hash") @db.VarChar(255) // null até cadastrar no 1º acesso
  primeiraVez  Boolean     @default(true) @map("Primeira_Vez")

  // Gate de dados pessoais do Aluno (PESSOAL-02, PESSOAL-06). Mesmo padrão de
  // `primeiraVez`: flag persistida, não recomputada a cada navegação. O
  // `@default(false)` vale tanto para o Aluno novo quanto, ao adicionar a
  // coluna, para todo Aluno que já existia — é o que faz o gate valer também
  // para conta anterior a esta feature, sem `UPDATE` manual.
  dadosPessoaisCompletos Boolean @default(false) @map("Dados_Pessoais_Completos")

  // Rate limiting de login (AD-028) — contadores por conta
  tentativasFalhas    Int       @default(0) @map("Tentativas_Falhas")
  bloqueadoAte        DateTime? @map("Bloqueado_Ate")

  // Auditoria
  dataCriacao  DateTime    @default(now()) @map("Data_Criacao")
  criadoPor    String?     @map("Criado_Por") @db.VarChar(14)
  criador      Usuario?    @relation("Cascata", fields: [criadoPor], references: [documento])
  criados      Usuario[]   @relation("Cascata")

  // Relações de domínio
  avaliacoes       AvaliacaoAluno[] @relation("AlunoAvaliacoes")
  dadosPessoais    DadoPessoalAluno[]
  cursosCriados    PreCurso[]       @relation("GoCursos")
  cursosOfertados  PreCurso[]       @relation("PreCursoOfertante")
  posCursosCriados PosCurso[]       @relation("GoPosCursos")
  verbas           Verba[]
  sessoes          Sessao[]

  @@index([cdOfertante])
  @@index([tipo])
  @@map("TB_Usuario")
}

// ─────────────────────────────────────────────────────────────
// SESSÃO  (AD-031: httpOnly/secure/sameSite, rotação, expiração)
// ─────────────────────────────────────────────────────────────

model Sessao {
  id            String    @id @default(uuid()) @map("ID_Sessao")
  // Nome de campo mantido (AD-043): largura ampliada para caber o CNPJ de um
  // GO logado, além do CPF dos demais tipos.
  cpfUsuario    String    @map("CPF_Usuario") @db.VarChar(14)
  usuario       Usuario   @relation(fields: [cpfUsuario], references: [documento], onDelete: Cascade)

  criadaEm      DateTime  @default(now()) @map("Criada_Em")
  ultimaAtividade DateTime @default(now()) @map("Ultima_Atividade")
  expiraEm      DateTime  @map("Expira_Em")

  @@index([cpfUsuario])
  @@map("TB_Sessao")
}

// ─────────────────────────────────────────────────────────────
// TENTATIVA DE LOGIN POR IP  (REQ-SEC-03: rate limit por origem,
// independente do CPF - complementa TB_Usuario.Tentativas_Falhas)
// ─────────────────────────────────────────────────────────────

model TentativaLoginIp {
  ip           String    @id @map("IP") @db.VarChar(45)
  tentativas   Int       @default(0) @map("Tentativas")
  bloqueadoAte DateTime? @map("Bloqueado_Ate")
  atualizadoEm DateTime  @updatedAt @map("Atualizado_Em")

  @@map("TB_Tentativa_Login_Ip")
}

// ─────────────────────────────────────────────────────────────
// VERBA  (AD-015: pertence ao GO/Ofertante, 1:N com Curso; AD-016: teto <=)
// `model Ofertante` removido (AD-043) - o GO passou a SER o Ofertante.
// ─────────────────────────────────────────────────────────────

model Verba {
  cdVerba        Int        @id @default(autoincrement()) @map("CD_Verba")
  // Aponta para o CNPJ (Usuario.documento) de um GO, não mais para um
  // `Ofertante` autônomo (AD-043). Nome de campo mantido.
  cdOfertante    String     @map("CD_Ofertante") @db.VarChar(14)
  ofertante      Usuario    @relation(fields: [cdOfertante], references: [documento])

  dtVerba        DateTime?  @map("DT_Verba") @db.Date
  vlVerba        Decimal    @map("VL_Verba") @db.Decimal(10, 2) // valor TOTAL da verba

  dataCriacao    DateTime   @default(now()) @map("Data_Criacao")

  // 1 verba : N cursos (a FK fica no curso). AD-015.
  cursos         PreCurso[]

  @@index([cdOfertante])
  @@map("TB_Verba")
}

// ─────────────────────────────────────────────────────────────
// PRÉ-CURSO  (AD-017, AD-018, AD-019)
// CD_Curso é PK autoincremento — NÃO é FK (bug corrigido).
// ─────────────────────────────────────────────────────────────

model PreCurso {
  cdCurso        Int              @id @default(autoincrement()) @map("CD_Curso")
  // Aponta para o CNPJ (Usuario.documento) de um GO, não mais para um
  // `Ofertante` autônomo (AD-043). Nome de campo mantido.
  cdOfertante    String           @map("CD_Ofertante") @db.VarChar(14)
  ofertante      Usuario          @relation("PreCursoOfertante", fields: [cdOfertante], references: [documento])

  // Verba que custeia este curso + valor alocado (AD-015, AD-016)
  cdVerba        Int              @map("CD_Verba")
  verba          Verba            @relation(fields: [cdVerba], references: [cdVerba])
  vlCursoAlocado Decimal          @map("VL_Curso_Alocado") @db.Decimal(10, 2)

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  dataCriacao       DateTime      @default(now()) @map("Data_Criacao")
  criadoPor         String        @map("Criado_Por") @db.VarChar(14)
  criador           Usuario       @relation("GoCursos", fields: [criadoPor], references: [documento])
  dataEncerramento  DateTime?     @map("Data_Encerramento")

  posCurso       PosCurso?
  avaliacoes     AvaliacaoAluno[]
  linhasResposta RespostaPreCurso[]

  @@index([cdOfertante])
  @@index([cdVerba])
  @@map("TB_Pre_Curso")
}

// ─────────────────────────────────────────────────────────────
// PÓS-CURSO  (AD-017, AD-018: agora COM encerramento pelo GO)
// ─────────────────────────────────────────────────────────────

model PosCurso {
  cdCurso        Int              @id @map("CD_Curso")
  preCurso       PreCurso         @relation(fields: [cdCurso], references: [cdCurso], onDelete: Cascade)

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  dataCriacao          DateTime   @default(now()) @map("Data_Criacao")
  criadoPor            String     @map("Criado_Por") @db.VarChar(14)
  criador              Usuario    @relation("GoPosCursos", fields: [criadoPor], references: [documento])
  dataUltimaAtualizacao DateTime  @updatedAt @map("Data_Ultima_Atualizacao")
  dataEncerramento     DateTime?  @map("Data_Encerramento")

  linhasResposta       RespostaPosCurso[]

  @@map("TB_Pos_Curso")
}

// ─────────────────────────────────────────────────────────────
// AVALIAÇÃO DO ALUNO  (AD-018, AD-020, AD-022, AD-023)
// Chave composta (CPF + CD_Curso). Aluno pode ter vários cursos ao
// longo do tempo, mas só um em andamento por vez — regra aplicada na
// camada de aplicação (AD-022), não por constraint física.
// ─────────────────────────────────────────────────────────────

model AvaliacaoAluno {
  // Nome de campo mantido (AD-043): sempre referência a um Aluno, que nunca
  // muda de documento (continua CPF de 11 dígitos) - só a largura da coluna
  // acompanha `Usuario.documento`, que agora é VarChar(14).
  cpf            String           @map("CPF") @db.VarChar(14)
  cdCurso        Int              @map("CD_Curso")

  aluno          Usuario          @relation("AlunoAvaliacoes", fields: [cpf], references: [documento])
  curso          PreCurso         @relation(fields: [cdCurso], references: [cdCurso])

  status         StatusFormulario @default(EM_ANDAMENTO) @map("Status")

  // Gate da Parte 2 (AD-023): dados pessoais/motivação completos.
  parte1Completa Boolean          @default(false) @map("Parte1_Completa")

  dataCriacao       DateTime      @default(now()) @map("Data_Criacao")
  dataEncerramento  DateTime?     @map("Data_Encerramento")

  linhasResposta    RespostaAvaliacao[]

  @@id([cpf, cdCurso])
  @@index([cdCurso])
  @@map("TB_Avaliacao_Aluno")
}

// ─────────────────────────────────────────────────────────────
// RESPOSTAS NORMALIZADAS  (RESP-05, RESP-06, RESP-18)
// Uma linha por resposta, três tabelas de forma idêntica — uma por
// formulário, cada uma com FK real para o seu pai. Estas tabelas são a
// ÚNICA fonte das respostas: a coluna `Respostas` dos três modelos foi
// dropada pela migração `20260910222847_remover_coluna_respostas`.
//
// `Chave` é a chave do schema Zod (AD-004), que já é a fonte de verdade
// da forma. `Ordem` é a posição dentro de uma seleção múltipla; 0 para
// valor escalar. `Valor` guarda o texto que o Zod já valida hoje — o tipo
// real é reconstruído na leitura por `src/lib/respostas/forma.ts`.
// ─────────────────────────────────────────────────────────────

model RespostaPreCurso {
  id       Int      @id @default(autoincrement()) @map("ID_Resposta")
  cdCurso  Int      @map("CD_Curso")
  preCurso PreCurso @relation(fields: [cdCurso], references: [cdCurso], onDelete: Cascade)

  chave    String   @map("Chave") @db.VarChar(100)
  ordem    Int      @default(0) @map("Ordem")
  valor    String   @map("Valor") @db.Text

  @@unique([cdCurso, chave, ordem])
  @@index([chave])
  @@map("TB_Resposta_Pre_Curso")
}

model RespostaPosCurso {
  id       Int      @id @default(autoincrement()) @map("ID_Resposta")
  cdCurso  Int      @map("CD_Curso")
  posCurso PosCurso @relation(fields: [cdCurso], references: [cdCurso], onDelete: Cascade)

  chave    String   @map("Chave") @db.VarChar(100)
  ordem    Int      @default(0) @map("Ordem")
  valor    String   @map("Valor") @db.Text

  @@unique([cdCurso, chave, ordem])
  @@index([chave])
  @@map("TB_Resposta_Pos_Curso")
}

model RespostaAvaliacao {
  id        Int            @id @default(autoincrement()) @map("ID_Resposta")
  // Nome de campo mantido (AD-043) - largura acompanha AvaliacaoAluno.cpf.
  cpf       String         @map("CPF") @db.VarChar(14)
  cdCurso   Int            @map("CD_Curso")
  avaliacao AvaliacaoAluno @relation(fields: [cpf, cdCurso], references: [cpf, cdCurso], onDelete: Cascade)

  chave     String         @map("Chave") @db.VarChar(100)
  ordem     Int            @default(0) @map("Ordem")
  valor     String         @map("Valor") @db.Text

  @@unique([cpf, cdCurso, chave, ordem])
  @@index([chave])
  @@map("TB_Resposta_Avaliacao")
}

// ─────────────────────────────────────────────────────────────
// DADO PESSOAL DO ALUNO  (PESSOAL-07, PESSOAL-08, PESSOAL-09)
// Mesma forma `(pai, Chave, Ordem, Valor)` das três tabelas acima, só
// que a chave-pai é o CPF sozinho: as 7 perguntas da seção DADOS
// PESSOAIS (Q3-Q9) são atributo da pessoa, não da matrícula. Uma linha
// por (Aluno, pergunta, posição) — o Aluno é a mesma pessoa em qualquer
// curso que faça.
//
// `onDelete: Cascade` satisfaz PESSOAL-09 por constraint física, sem
// lógica de aplicação: removeu o Aluno, os dados pessoais dele vão junto.
// ─────────────────────────────────────────────────────────────

model DadoPessoalAluno {
  id      Int     @id @default(autoincrement()) @map("ID_Dado")
  // Nome de campo mantido (AD-043) - largura acompanha Usuario.documento.
  cpf     String  @map("CPF") @db.VarChar(14)
  usuario Usuario @relation(fields: [cpf], references: [documento], onDelete: Cascade)

  chave   String  @map("Chave") @db.VarChar(100)
  ordem   Int     @default(0) @map("Ordem")
  valor   String  @map("Valor") @db.Text

  @@unique([cpf, chave, ordem])
  @@index([chave])
  @@map("TB_Dado_Pessoal_Aluno")
}

// ─────────────────────────────────────────────────────────────
// NOTA — Estratégia de armazenamento das respostas dos questionários
// ─────────────────────────────────────────────────────────────
// Histórico, porque a decisão mudou uma vez e o motivo importa.
//
// Até 2026-09, os três questionários (127 chaves) viviam num campo
// `Respostas Json?` por formulário, com a FORMA validada por Zod na
// aplicação (AD-034). Isso deixou o esquema físico enxuto e absorveu a
// troca inteira dos três questionários (AD-035/036/037) sem uma única
// migration. O custo aceito na época: agregar por pergunta exigiria
// parsear JSON, e a decisão de normalizar ficou adiada "para quando a
// feature de dashboard existir".
//
// Desde AD-041, a decisão é outra: uma linha por resposta em
// `TB_Resposta_Pre_Curso`, `TB_Resposta_Pos_Curso` e
// `TB_Resposta_Avaliacao`. Cada linha guarda a chave da pergunta (a mesma
// do schema Zod), o valor como texto, e a posição — seleção múltipla vira
// N linhas. A aplicação remonta o objeto `{ chave: valor }` na leitura
// (`src/lib/respostas/repositorio.ts`), então completude, condicionais e
// os formulários continuam vendo o mesmo objeto de sempre.
//
// O Zod segue sendo a autoridade de forma/obrigatoriedade/condicionais
// (AD-004, REQ-SEC-17) — o que mudou foi só onde o dado repousa. O custo
// desta vez: reescrever o texto de uma opção passa a exigir tocar nos
// dados, não só no schema.
