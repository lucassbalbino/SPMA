  p29e     Boolean?  @map("P29e")
  p29f     Boolean?  @map("P29f")
  p35      Int?      @map("P35") @db.TinyInt
  p36      String?   @map("P36") @db.Text
  p37      String?   @map("P37") @db.Char(1)
  p38      String?   @map("P38") @db.Text


  @@id([cpf, cdCurso])
  @@index([cdCurso])
  @@map("TB_Avaliacao_Aluno")
}

// ─────────────────────────────────────────────────────────────
// DADO PESSOAL DO ALUNO  (PESSOAL-07, PESSOAL-08, PESSOAL-09, AD-051)
// Uma linha por Aluno, com as 7 perguntas da seção DADOS PESSOAIS
// (P3-P9) como colunas. A chave é o CPF sozinho: são atributo da pessoa,
// não da matrícula, e valem para qualquer curso que ela faça.
//
// `onDelete: Cascade` satisfaz PESSOAL-09 por constraint física, sem
// lógica de aplicação: removeu o Aluno, os dados pessoais dele vão junto.
// ─────────────────────────────────────────────────────────────

model DadoPessoalAluno {
  // Nome de campo mantido (AD-043) - largura acompanha Usuario.documento.
  cpf     String  @id @map("CPF") @db.VarChar(14)
  usuario Usuario @relation(fields: [cpf], references: [documento], onDelete: Cascade)

  // Respostas, uma coluna por pergunta (AD-051, `src/lib/respostas/colunas.ts`).
  p3       String?   @map("P3") @db.Char(2)
  p4       String?   @map("P4") @db.Text
  p5       String?   @map("P5") @db.Char(1)
  p6       String?   @map("P6") @db.Char(1)
  p7       String?   @map("P7") @db.Char(1)
  p8       String?   @map("P8") @db.Char(1)
  p9       String?   @map("P9") @db.Char(1)


  @@map("TB_Dado_Pessoal_Aluno")
}

// ─────────────────────────────────────────────────────────────
// NOTA — Estratégia de armazenamento das respostas dos questionários
// ─────────────────────────────────────────────────────────────
// Histórico, porque a decisão mudou uma vez e o motivo importa.
//
// Até 2026-09, os três questionários (127 chaves) viviam num campo
// `Respostas Json?` por formulário, com a FORMA validada por Zod na
// aplicação (AD-034). Isso deixou o esquema físico enxuto e absorveu a
// troca inteira dos três questionários (AD-035/036/037) sem uma única
// migration. O custo aceito na época: agregar por pergunta exigiria
// parsear JSON, e a decisão de normalizar ficou adiada "para quando a
// feature de dashboard existir".
//
// A AD-041 (2026-09-11) trocou o JSON por uma linha por resposta, em
// tabelas `(Chave, Ordem, Valor)`. Agregar por pergunta ficou direto, mas a
// pergunta continuava sendo um VALOR da coluna `Chave`: cruzar duas perguntas
// exigia pivotar a tabela.
//
// Desde a AD-051 (2026-10-27), cada pergunta é uma coluna `P*` da tabela do
// próprio formulário, com o nome do questionário em papel (`P11`, `P7a`,
// `P25.1`), e cada formulário é uma linha - o formato que o Power BI filtra
// e cruza sem tratamento. Escolha única guarda a letra da opção, múltipla
// escolha tem uma coluna 1/0 por opção. O mapa chave → coluna e as
// conversões ficam em `src/lib/respostas/colunas.ts`; a aplicação continua
// vendo o mesmo objeto `{ chave: valor }` de sempre.
//
// O Zod segue sendo a autoridade de forma/obrigatoriedade/condicionais
// (AD-004, REQ-SEC-17). O custo desta vez: pergunta nova é coluna nova, e
// mudar a ordem das opções exige converter as letras gravadas.
