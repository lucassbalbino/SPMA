# Ambiente de teste (integration/e2e). NUNCA comitar segredos reais aqui.
# Mesmo MySQL do docker-compose, banco dedicado `spma_test`.
# allowPublicKeyRetrieval: MySQL 8.4 usa caching_sha2_password; sem TLS, um
# cliente só consegue autenticar sem essa opção enquanto o cache de auth do
# servidor está "quente". A cada restart do MySQL/Docker o cache esfria e
# integration/e2e travam num timeout de pool de 10s sem menção a auth em
# lugar nenhum (achado do Verifier, validation.md iteração 3, seção E3).
# Só dev/test - produção usa TLS (ver Assunções em spec.md).
DATABASE_URL="mysql://spma:spma_dev_only@localhost:3306/spma_test?allowPublicKeyRetrieval=true"

NODE_ENV="test"

# Admin Master semeado pelo global setup do Playwright (e2e/global-setup.ts)
# antes de cada rodada e2e - CPF válido por módulo 11 (necessário para
# logar pela rota real de login a partir da Fase 3).
SEED_AM_CPF="52998224725"
SEED_AM_NOME="Admin Master (e2e)"
