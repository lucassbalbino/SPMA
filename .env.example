# Copie este arquivo para `.env` e ajuste se necessário.
# NUNCA comite o `.env` real (já está no .gitignore).

# Conexão com o MySQL do docker-compose (desenvolvimento local).
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://spma:spma_dev_only@localhost:3306/spma"

# Segredo para assinar/gerir sessões. Gere um valor aleatório forte em produção.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-isto-por-um-valor-aleatorio-forte"

# Ambiente. Em "production", erros ao cliente são genéricos (REQ-SEC-11).
NODE_ENV="development"
