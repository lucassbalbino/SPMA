# Copie este arquivo para `.env` e ajuste se necessário.
# NUNCA comite o `.env` real (já está no .gitignore).

# Conexão com o MySQL do docker-compose (desenvolvimento local).
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
# allowPublicKeyRetrieval: sem ele, depois de todo restart do MySQL/Docker a
# conexão trava num timeout de pool de 10s (caching_sha2_password sem TLS
# exige isso para reaquecer o cache de auth). Só dev/test - produção usa TLS.
DATABASE_URL="mysql://spma:spma_dev_only@localhost:3306/spma?allowPublicKeyRetrieval=true"

# Segredo para assinar/gerir sessões. Gere um valor aleatório forte em produção.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-isto-por-um-valor-aleatorio-forte"

# Ambiente. Em "production", erros ao cliente são genéricos (REQ-SEC-11).
NODE_ENV="development"

# Dashboard Power BI Embedded (AD-056, /relatorios). Sem estas variáveis o
# resto do sistema funciona e /relatorios mostra "Dashboard indisponível".
# Valores do Entra ID e do workspace do cliente. O SEGREDO nunca vai para o
# git nem para o chat: só no `.env` local e em /opt/spma/shared/.env.production.
SPMA_TENANT_ID=""
SPMA_CLIENT_ID=""
SPMA_CLIENT_SECRET=""
SPMA_DATASET_ID=""
SPMA_REPORT_ID=""
# Entre aspas: a URL tem `&` e `%3d`.
SPMA_EMBED_URL=""
# Opcional, em par: relatório próprio do painel nacional (AM/GT/VT) ou do
# ofertante (GO/VO). Sem o par, o painel usa SPMA_REPORT_ID/SPMA_EMBED_URL.
# SPMA_REPORT_ID_NACIONAL=""
# SPMA_EMBED_URL_NACIONAL=""
# SPMA_REPORT_ID_OFERTANTE=""
# SPMA_EMBED_URL_OFERTANTE=""
